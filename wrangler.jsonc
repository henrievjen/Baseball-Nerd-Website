{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baseball-nerd-website",
  "compatibility_date": "2025-05-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist/baseball-nerd/browser",
    "html_handling": "drop-trailing-slash",
    // Every route is now a real, prerendered index.html file (see the
    // Angular "prerender" build option), so a genuinely nonexistent URL
    // should 404 instead of silently serving the homepage. That silent
    // 200-for-everything behavior is what "single-page-application" did,
    // and it's what produced the soft-404 / duplicate-content problem
    // AdSense flagged. "404-page" serves src/404.html with a real HTTP 404.
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
